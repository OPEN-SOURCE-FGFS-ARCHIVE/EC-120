  </instrumentation -->

  <menubar>
   <default>
    <menu n="100">
     <label>EC-120</label>
     <item>
      <label>Select MP-pilot</label>
      <binding>
       <command>nasal</command>
       <script>
        dual_control_tools.
          copilot_dialog.show(aircraft_dual_control.pilot_type);
       </script>
      </binding>
     </item>
    </menu>
   </default>
  </menubar>
  
  <instrumentation>
			<!-- <path>Aircraft/EC-120/Instruments/instrumentation.xml</path> -->
			<path>Aircraft/EC-120/System/instruments.xml</path>
		</instrumentation>

 </sim>

