		<gui>
			<style>
				<colors>
					<splash-font>
						<red>0.25</red>
						<green>0.28</green>
						<blue>0.31</blue>
					</splash-font>
				</colors>
			</style>
		</gui>
		
		
			  <systems>

	    <autopilot n="102">
        <path>Aircraft/EC-120/System/glass-rain.xml</path>
        </autopilot>
		
		
	    <autopilot n="103">
            <path>Aircraft/EC-120/System/sound-rules.xml</path>
        </autopilot>
    </systems>
		
		
  <!-- 3d model -->
  <model>
   <path>Aircraft/EC-120/Models/EC120-Passenger.xml</path>
  </model>
  
  	 <rendering>
		<refl_correction type="string">-0.24</refl_correction>
		<fresnel-factor>0.2</fresnel-factor>
	</rendering>

  <!-- Views -->
  <view n="0">
			<internal archive="y">true</internal>
			<config>
				<x-offset-m archive="y">-0.348</x-offset-m><!--right-->
				<y-offset-m archive="y">0.415</y-offset-m><!--up-->
				<z-offset-m archive="y">-1.54</z-offset-m><!--back-->
				<pitch-offset-deg archive="y">-6</pitch-offset-deg>
				<limits>
					<enabled type="bool">true</enabled>
					<left>
						<heading-max-deg type="double">160</heading-max-deg>
						<x-offset-max-m type="double">0.30</x-offset-max-m>
						<x-offset-threshold-deg type="double">65</x-offset-threshold-deg>
					</left>
					<right>
						<heading-max-deg type="double">140</heading-max-deg>
						<x-offset-max-m type="double">0.15</x-offset-max-m>
						<x-offset-threshold-deg type="double">65</x-offset-threshold-deg>
					</right>
				</limits>
			</config>
		</view>
  <!-- Views -->
  <view n="100">
    <name>Pilot cam</name>
        <internal archive="y">true</internal>
        <config>
		 <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <x-offset-m archive="y">0</x-offset-m><!--right-->
				<y-offset-m archive="y">0.8</y-offset-m><!--up-->
				<z-offset-m archive="y">-2.7</z-offset-m><!--back-->
          <pitch-offset-deg>0</pitch-offset-deg>
		  <heading-offset-deg>199</heading-offset-deg>
          <default-field-of-view-deg>110</default-field-of-view-deg>
        </config>
     
  </view>
  
  
  	 <view n="109">
    <name>Pilot cam</name>
        <internal archive="y">true</internal>
        <config>
		 <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <x-offset-m archive="y">0</x-offset-m><!--right-->
				<y-offset-m archive="y">0.4</y-offset-m><!--up-->
				<z-offset-m archive="y">-2.0</z-offset-m><!--back-->
          <pitch-offset-deg>0</pitch-offset-deg>
		  <heading-offset-deg>199</heading-offset-deg>
          <default-field-of-view-deg>110</default-field-of-view-deg>
        </config>
     
  </view>
  
  
  	<view n="101">
			<name>Rear cabin</name>
			<internal archive="y">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m archive="y">0</x-offset-m><!--right-->
				<y-offset-m archive="y">0.5</y-offset-m><!--up-->
				<z-offset-m archive="y">-0.35</z-offset-m><!--back-->
				<pitch-offset-deg>-5</pitch-offset-deg>
				<heading-offset-deg>0</heading-offset-deg>
				<default-field-of-view-deg>65</default-field-of-view-deg>
			</config>
		</view>
		
		
		<view n="102">
			<name>Over the shoulder</name>
			<internal archive="y">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m archive="y">0.65</x-offset-m><!--right-->
				<y-offset-m archive="y">0.55</y-offset-m><!--up-->
				<z-offset-m archive="y">-0.8</z-offset-m><!--back-->
				<pitch-offset-deg archive="y">-6</pitch-offset-deg>
				<pitch-offset-deg>-19</pitch-offset-deg>
				<heading-offset-deg>0</heading-offset-deg>
				<default-field-of-view-deg>65</default-field-of-view-deg>
			</config>
		</view>
		
  <view n="1">
			<config>
				<target-z-offset-m archive="y" type="double">2.5</target-z-offset-m>
			</config>
		</view>

		<view n="2">
			<config>
				<target-z-offset-m archive="y" type="double">2.5</target-z-offset-m>
			</config>
		</view>

		<view n="3">
