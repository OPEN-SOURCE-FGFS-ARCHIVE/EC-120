<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>rotors.ac</path>
	
 <!--  REMBRANDT support for transparent objects-->
    <effect>
        <inherits-from>Effects/model-transparent</inherits-from>
        <condition>
            <property>sim/rendering/rembrandt/enabled</property>
        </condition>
		 <object-name>blurred1</object-name>
		
		 <object-name>blurred2</object-name>
		
		 <object-name>blurred3</object-name>
		
		
	
        <object-name>blade1-1</object-name>
        <object-name>blade1-2</object-name>
        <object-name>blade1-3</object-name>
        <object-name>blade1-4</object-name>
	<object-name>blade2-1</object-name>
        <object-name>blade2-2</object-name>
        <object-name>blade2-3</object-name>
        <object-name>blade2-4</object-name>
	<object-name>blade3-1</object-name>
        <object-name>blade3-2</object-name>
        <object-name>blade3-3</object-name>
        <object-name>blade3-4</object-name>
    </effect> 
	
    <animation>
	<type>material</type>
	<object-name>blade1-1</object-name>
        <object-name>blade1-2</object-name>
        <object-name>blade1-3</object-name>
        <object-name>blade1-4</object-name>
	<object-name>blade2-1</object-name>
        <object-name>blade2-2</object-name>
        <object-name>blade2-3</object-name>
        <object-name>blade2-4</object-name>
	<object-name>blade3-1</object-name>
        <object-name>blade3-2</object-name>
        <object-name>blade3-3</object-name>
        <object-name>blade3-4</object-name>
		
		<transparency>
			<alpha-prop>rotors/main/rpm</alpha-prop>
			<factor>-0.0045</factor>
			<offset>1</offset>
			<max>1</max>
		</transparency>
    </animation>
	
    <animation>
	<type>material</type>
	 <object-name>blurred1</object-name>
		
		 <object-name>blurred2</object-name>
		
		 <object-name>blurred3</object-name>
		
		
		<transparency>
			<alpha-prop>rotors/main/rpm</alpha-prop>
			<factor>0.016</factor>
			<offset>-0.25</offset>
			<max>0.4</max>
		</transparency>
		<threshold>0.001</threshold>
    </animation>

    <animation>
        <name>blade-1</name>
        <object-name>blade1-1</object-name>
        <object-name>blade1-2</object-name>
        <object-name>blade1-3</object-name>
        <object-name>blade1-4</object-name>
		
    </animation>

    <animation>
        <name>blade-2</name>
        <object-name>blade2-1</object-name>
        <object-name>blade2-2</object-name>
        <object-name>blade2-3</object-name>
        <object-name>blade2-4</object-name>
		
			 
    </animation>

    <animation>
        <name>blade-3</name>
        <object-name>blade3-1</object-name>
        <object-name>blade3-2</object-name>
        <object-name>blade3-3</object-name>
        <object-name>blade3-4</object-name>
	
		 
    </animation>	

   <animation>
        <type>rotate</type>
        <object-name>MainHub</object-name>
        <object-name>blade-1</object-name>
        <object-name>blade-2</object-name>
        <object-name>blade-3</object-name>
        <property>rotors/main/tilt/pitch-deg</property>
	<factor>-1</factor>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>2.025</z-m>
        </center>
        <axis>
            <x>0.0</x>
            <y>1.0</y>
            <z>0.0</z>
        </axis>
    </animation>
	
