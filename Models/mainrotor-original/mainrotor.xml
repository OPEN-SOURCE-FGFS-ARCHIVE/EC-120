    <animation>
        <type>select</type>
       <object-name>blurred1</object-name>
		
		 <object-name>blurred2</object-name>
		
		 <object-name>blurred3</object-name>
        <condition>
            <greater-than>
                <property>rotors/main/rpm</property>
                <value>200.999</value>
            </greater-than>
        </condition>
    </animation>
	
    <animation>
        <type>spin</type>
        <object-name>MainHub</object-name>
		 <object-name>blurred1</object-name>
		
		 <object-name>blurred2</object-name>
		
		 <object-name>blurred3</object-name>
        <property>rotors/main/rpm</property>
	<factor>-1</factor>
        <center>
            <!--x-m>0.009</x-m>
            <y-m>-0.005</y-m>
            <z-m>2.025</z-m-->
            <x-m> 0.019</x-m>
            <y-m>-0.011</y-m>
            <z-m> 1.646</z-m>
        </center>
        <axis>
            <x>0.0</x>
            <y>0.0</y>
            <z>1.0</z>
	    <!--x2-m> 0.009</x2-m>
	    <y2-m>-0.005</y2-m>
            <z2-m> 2.185</z2-m>
            <x1-m> 0.019</x1-m>
            <y1-m>-0.005</y1-m>
            <z1-m> 2.185</z1-m-->
        </axis>
    </animation>
	
	<!--  Blade 1-->

    <animation>
        <type>rotate</type>
        <object-name>blade-1</object-name>
        <property>rotors/main/blade/position-deg</property>
	<factor>-1</factor>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>2.025</z-m>
        </center>
        <axis>
            <x>0.0</x>
            <y>0.0</y>
            <z>1.0</z>
        </axis>
    </animation>

    <animation>
        <type>rotate</type>
        <object-name>blade-1</object-name>
        <property>rotors/main/blade/incidence-deg</property>
	<factor>-1</factor>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>2.025</z-m>
        </center>
        <axis>
            <x>1.0</x>
            <y>-0.0</y>
            <z>0.0</z>
        </axis>
    </animation>
	
    <animation>
        <type>rotate</type>
        <object-name>blade1-2</object-name>
        <object-name>blade1-3</object-name>
        <object-name>blade1-4</object-name>
        <property>rotors/main/blade/flap-deg</property>
        <factor>0.2</factor>
        <center>
            <x-m>1.43</x-m>
            <y-m>0.075</y-m>
            <z-m>2.025</z-m>
        </center>
        <axis>
            <x>0</x>
            <y>-1.0</y>
            <z>0.0</z>
        </axis>
    </animation>
	
    <animation>
        <type>rotate</type>
        <object-name>blade1-3</object-name>
        <object-name>blade1-4</object-name>
        <property>rotors/main/blade/flap-deg</property>
        <factor>0.5</factor>
        <center>
             <x-m>2.79</x-m>
             <y-m>0.075</y-m>
             <z-m>2.025</z-m>
        </center>
        <axis>
            <x>0</x>
