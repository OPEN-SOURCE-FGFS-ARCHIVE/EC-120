<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

 
 

    
    <path>pedals.ac</path>
 
 
 
<!-- left pedal -->
  
   <animation>
    <type>rotate</type>
    <object-name>disk.002</object-name>
	<object-name>disk.003</object-name>
	<object-name>rect.001</object-name>
    <property>controls/flight/rudder</property>
    <factor> 8 </factor>
    <offsets>
      <x-m>  0.0 </x-m>
      <y-m>  -0.01 </y-m>
      <z-m> 0.0</z-m>
    </offsets>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>
  
  
  <!-- right pedal -->
  
   <animation>
    <type>rotate</type>
    <object-name>disk</object-name>
	  <object-name>disk.001</object-name>
	    <object-name>rect</object-name>
    <property>controls/flight/rudder</property>
    <factor> -8 </factor>
    <offsets>
      <x-m>  0.0 </x-m>
      <y-m>  0.01 </y-m>
      <z-m> 0.0</z-m>
    </offsets>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>
 
 

</PropertyList>

