    <type>material</type>
    <object-name>ball_AI_main</object-name>
    <object-name>aircraft</object-name>
    <object-name>needle.glideslope</object-name>
    <object-name>needle.localiser</object-name>
    <object-name>AI-face</object-name>
    <object-name>roll-pointer</object-name>
    <object-name>GS-pointer</object-name>
    <object-name>ASIfase</object-name>
    <object-name>needle_ASI</object-name>
    <object-name>ALTface</object-name>
    <object-name>needle_Alt1</object-name>
    <object-name>needle_Alt2</object-name>
    <object-name>VSIface</object-name>
    <object-name>needle_VSI</object-name>
    <object-name>clockFrameface</object-name>
    <object-name>SecondHand</object-name>
    <object-name>MinuteHand</object-name>
    <object-name>HourHand</object-name>
    <object-name>frameface</object-name>
    <object-name>GSneedle</object-name>
