    <object-name>pointer_Course</object-name>
  </animation>

  <!-- -2.182	0.117	-0.142                                   ASI / Air Speed Indicator -->
  <animation>
    <type>rotate</type>
    <object-name>needle_ASI</object-name>
    <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
    <interpolation>
      <entry>
        <ind> -999 </ind>
        <dep>   0 </dep>
      </entry>
      <entry>
        <ind>    0 </ind>
        <dep>   0 </dep>
      </entry>
      <entry>
        <ind>   30 </ind>
        <dep>  30 </dep>
      </entry>
      <entry>
        <ind>   60 </ind>
        <dep>  85 </dep>
      </entry>
      <entry>
        <ind>  120 </ind>
        <dep> 192 </dep>
      </entry>
      <entry>
        <ind>  200 </ind>
        <dep> 335 </dep>
      </entry>
      <entry>
        <ind>  999 </ind>
        <dep> 336 </dep>
      </entry>
    </interpolation>
    <center>
      <x-m>0.000</x-m>      <!-- back -->
      <y-m>0.142</y-m>      <!-- right -->
      <z-m>0.117</z-m>      <!-- up -->
    </center>
    <axis>
      <x> -1 </x>      <!--  roll -->
      <y>  0 </y>      <!-- pitch -->
      <z>  0 </z>      <!--   yaw -->
    </axis>
  </animation>  <!--                                                end of animation ASI -->

  <!-- -2.213 0.103 -0.229                  AI / Attitude Indicator / Artificial Horizon -->
  <animation>
    <type>rotate</type>
    <object-name>ball_AI_main</object-name>
    <property>/orientation/roll-deg</property>
    <factor>1</factor>
    <center>
      <x-m>0.000</x-m>
      <y-m>0.229</y-m>      <!-- right -->
      <z-m>0.103</z-m>      <!-- up -->
    </center>
    <axis>
      <x> 1 </x>      <!--  roll -->
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>ball_AI_main</object-name>
    <property>/orientation/pitch-deg</property>
    <factor>1</factor>
    <center>
      <x-m> -2.213 </x-m>      <!-- back -->
      <y-m>  0.000 </y-m>
      <z-m>  0.103 </z-m>      <!-- up -->
    </center>
    <axis>
      <x>0</x>
      <y>1</y>      <!-- pitch -->
      <z>0</z>
    </axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>roll-pointer</object-name>
    <property>/orientation/roll-deg</property>
    <factor>1</factor>
    <center>
      <x-m>0.000</x-m>
      <y-m>0.229</y-m>      <!-- right -->
      <z-m>0.103</z-m>      <!-- up -->
    </center>
    <axis>
      <x> 1 </x>      <!--  roll -->
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>  <!--                                                end of animation AHI -->

  <!--       rotationVSI	-2.182	 0.042	-0.312          VSI / Vertical Speed Indicator -->
  <animation>
    <type>rotate</type>
    <object-name>needle_VSI</object-name>
    <property>instrumentation/vertical-speed-indicator/indicated-speed-fpm</property>
    <interpolation>
      <entry>
        <ind> -2500 </ind>
        <dep>  -165 </dep>
      </entry>
      <entry>
        <ind> -2000 </ind>
        <dep>  -142 </dep>
      </entry>
      <entry>
        <ind> -1500 </ind>
        <dep> -110 </dep>
      </entry>
      <entry>
        <ind> -1000 </ind>
        <dep>  -82 </dep>
      </entry>
      <entry>
        <ind>  -500 </ind>
        <dep>  -40 </dep>
      </entry>
      <entry>
        <ind>     0 </ind>
        <dep>    0 </dep>
      </entry>
      <entry>
        <ind>   500 </ind>
        <dep>   40 </dep>
      </entry>
      <entry>
        <ind>  1000 </ind>
        <dep>   82 </dep>
      </entry>
      <entry>
        <ind>  1500 </ind>
        <dep>  110 </dep>
      </entry>
      <entry>
        <ind>  2000 </ind>
        <dep>  142 </dep>
      </entry>
      <entry>
        <ind>  2500 </ind>
        <dep>  165 </dep>
      </entry>
    </interpolation>
    <center>
      <x-m>0.000</x-m>      <!-- back -->
      <y-m>0.312</y-m>      <!-- right -->
      <z-m>0.042</z-m>      <!-- up -->
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>  <!--                                                end of animation VSI -->

  <!--  rotationAlt	-2.188	 0.116	-0.312                           Altimeter Needles -->
  <animation>
    <type>rotate</type>
    <object-name>needle_Alt1</object-name>
    <property>instrumentation/altimeter/indicated-altitude-ft</property>
    <factor>0.36</factor>
    <center>
      <x-m>0</x-m>
      <y-m>0.312</y-m>      <!-- right -->
      <z-m>0.116</z-m>      <!-- up -->
    </center>
    <axis>
      <x>-1</x>
      <y>0</y>
      <z>0</z>
    </axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>needle_Alt2</object-name>
    <property>instrumentation/altimeter/indicated-altitude-ft</property>
    <factor>0.036</factor>
    <center>
      <x-m>0</x-m>
      <y-m>0.312</y-m>      <!-- right -->
      <z-m>0.116</z-m>      <!-- up -->
    </center>
    <axis>
      <x>-1</x>
      <y>0</y>
      <z>0</z>
    </axis>
  </animation>  <!--                                           end of animation Altimeter -->

  <!--    -2.183	-0.031	-0.142                                                  Clock  -->
  <animation>
    <type>rotate</type>
    <object-name>HourHand</object-name>
    <property>instrumentation/clock/indicated-sec</property>
    <factor>0.00833333333333333</factor>
    <center>
      <x-m>0</x-m>
      <y-m>0.142</y-m>      <!-- right -->
      <z-m>-0.031</z-m>      <!-- up -->
    </center>
    <axis>
      <x>-1</x>
      <y>0</y>
      <z>0</z>
    </axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>MinuteHand</object-name>
    <property>instrumentation/clock/indicated-sec</property>
    <factor>0.1</factor>
    <center>
      <x-m>0</x-m>
      <y-m>0.142</y-m>      <!-- right -->
      <z-m>-0.031</z-m>      <!-- up -->
    </center>
    <axis>
      <x>-1</x>
      <y>0</y>
      <z>0</z>
    </axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>SecondHand</object-name>
    <property>instrumentation/clock/indicated-sec</property>
    <factor>6</factor>
    <center>
