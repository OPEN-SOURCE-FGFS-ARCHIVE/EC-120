    <object-name>knob_HeadingSelect</object-name>
    <condition>
      <property>controls/lighting/instrument-lights</property>
    </condition>
    <emission>
      <red>   0.80 </red>
      <green> 0.50 </green>
      <blue>  0.50 </blue>
    </emission>
  </animation>

  <!--  -->

  <model>
    <path>Aircraft/EC-120/Models/Interior/panel.ac</path>
    <offsets>
      <x-m>0</x-m>
      <y-m>0</y-m>
      <z-m>0 </z-m>
      <pitch-deg>0</pitch-deg>
