<PropertyList>

 
 

    
    <path>collective.ac</path>
	
	<animation>
    <name>CollectiveComplet</name>
  
    <object-name>disk.002</object-name>
	 <object-name>floattrigger</object-name>
	 
	
   <object-name>startbutton</object-name>
    <object-name>disk</object-name>
	 <object-name>disk.003</object-name>
	  <object-name>rect</object-name>
